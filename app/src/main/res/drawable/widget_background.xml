<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-translucent light black tinted frosted glass base layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#8C181822"
                android:centerColor="#730E0E14"
                android:endColor="#8008080C"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Specular light edge stroke for glassmorphism effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1.2dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>

